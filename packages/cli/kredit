#!/usr/bin/env bash
#
# kredit: the command line for the Kredit platform API
#
# Usage:
#   kredit login | logout | whoami
#   kredit orgs         list | get [id] | create --name N | update ID | delete ID | summary [id] | use ID
#   kredit rules        list | add | update RULE_ID | remove RULE_ID
#   kredit agents       list | get ID | create --name N --prompt P | update ID | freeze ID | unfreeze ID
#                       delete ID | verify ID | promote ID | decisions ID
#   kredit versions     propose AGENT_ID | approve AGENT_ID VID | reject AGENT_ID VID
#   kredit tokens       issue AGENT_ID [--ttl M] | list AGENT_ID | revoke AGENT_ID TOKEN_ID
#   kredit check        --agent ID "what the agent wants to do" [--amount N --merchant M --json]
#   kredit decisions    list | get ID | reviews | execute ID
#   kredit approvals    list
#   kredit documents    list | add --name N (--file PATH | --text T) | search --q Q | delete ID
#   kredit integrations list | set PROVIDER --key name=value | test PROVIDER
#   kredit audit | orders | seed
#   kredit environments list | create --name N | delete ID
#   kredit sim          run | list | get ID | stop ID
#   kredit commerce     workflows | update WF_ID | runs | run ID | start WF_ID | choose RUN_ID [FIND_ID]
#                       rechoose RUN_ID FIND_ID | stop RUN_ID
#
# Environment:
#   KREDIT_API_KEY   API key (or api_key=... in ~/.kredit/config, written by `kredit login`)
#   KREDIT_API_URL   Base URL (default: https://api.kredit.sh)
#   KREDIT_ORG       Organization id (or --org, or org=... in the config, or the first org)
#
# Run `kredit help` for every command and its flags.

set -euo pipefail

VERSION="1.0.1"
CONFIG_FILE="${HOME:-$(eval echo ~)}/.kredit/config"

# ── Config resolution ────────────────────────────────────────────────────────

config_get() {
  if [ -f "$CONFIG_FILE" ]; then
    grep -E "^$1=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d ' '
  fi
}

config_set() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  touch "$CONFIG_FILE"
  local tmp
  tmp=$(grep -vE "^$1=" "$CONFIG_FILE" 2>/dev/null || true)
  { [ -n "$tmp" ] && echo "$tmp"; echo "$1=$2"; } > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

resolve_api_key() {
  if [ -n "${KREDIT_API_KEY:-}" ]; then
    echo "$KREDIT_API_KEY"
    return
  fi
  config_get api_key
}

API_KEY=$(resolve_api_key)
BASE_URL="${KREDIT_API_URL:-https://api.kredit.sh}"
BASE_URL="${BASE_URL%/}"
DASHBOARD_URL="${KREDIT_DASHBOARD_URL:-https://kredit.sh}"

# ── Helpers ──────────────────────────────────────────────────────────────────

die() {
  echo "error: $1" >&2
  exit 1
}

require_api_key() {
  if [ -z "$API_KEY" ]; then
    die "No API key. Run 'kredit login', set KREDIT_API_KEY, or add api_key=... to ~/.kredit/config"
  fi
}

has_jq() { command -v jq &>/dev/null; }

# Format JSON output: jq when present, otherwise as-is
format_json() {
  if has_jq; then
    jq .
  else
    cat
  fi
}

# Escape a string for JSON (jq when present, python3 otherwise)
json_str() {
  if has_jq; then
    printf '%s' "$1" | jq -Rs .
  else
    printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
  fi
}

# A JSON array of strings from a comma separated list: "a, b" -> ["a","b"]
json_list() {
  local out="" item
  local IFS=','
  for item in $1; do
    item=$(echo "$item" | sed 's/^ *//; s/ *$//')
    [ -z "$item" ] && continue
    out="${out:+$out,}$(json_str "$item")"
  done
  echo "[$out]"
}

# Read one field from a JSON document on stdin (jq or python3)
json_field() {
  if has_jq; then
    jq -r "$1 // empty"
  else
    python3 -c "
import json, sys
doc = json.load(sys.stdin)
for part in '$1'.strip('.').split('.'):
    doc = doc.get(part) if isinstance(doc, dict) else None
print('' if doc is None else doc)
" 2>/dev/null
  fi
}

# Assemble a JSON object from "key:json" pairs, skipping empty values
json_obj() {
  local out="" pair key val
  for pair in "$@"; do
    key="${pair%%:*}"
    val="${pair#*:}"
    [ -z "$val" ] && continue
    out="${out:+$out,}\"$key\":$val"
  done
  echo "{$out}"
}

# "500/day" -> {"amount":500,"window":"day"}; "20/hr" with count for hit rates
parse_limit() {
  local spec="$1" field="$2" amount window
  amount="${spec%%/*}"
  window="${spec#*/}"
  [ "$amount" = "$spec" ] && window="day"
  case "$window" in
    txn|sec|min|hr|day|wk|mo|quarter|year) ;;
    *) die "Invalid window '$window' in '$spec'. Use txn, sec, min, hr, day, wk, mo, quarter or year" ;;
  esac
  echo "{\"$field\":$amount,\"window\":\"$window\"}"
}

# ── Argument parsing ─────────────────────────────────────────────────────────
#
# Flags come as --name=value or --name value. Anything else is positional.
# parse_args fills POS (positionals) and FLAG_KEYS/FLAG_VALS (parallel lists).

POS=()
FLAG_KEYS=()
FLAG_VALS=()

parse_args() {
  POS=()
  FLAG_KEYS=()
  FLAG_VALS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --*=*)
        FLAG_KEYS+=("${1%%=*}")
        FLAG_VALS+=("${1#*=}")
        ;;
      --*)
        if [ $# -gt 1 ] && [[ "$2" != --* ]]; then
          FLAG_KEYS+=("$1")
          FLAG_VALS+=("$2")
          shift
        else
          FLAG_KEYS+=("$1")
          FLAG_VALS+=("true")
        fi
        ;;
      *)
        POS+=("$1")
        ;;
    esac
    shift
  done
}

# flag --name [default]
flag() {
  local i
  for i in "${!FLAG_KEYS[@]}"; do
    if [ "${FLAG_KEYS[$i]}" = "$1" ]; then
      echo "${FLAG_VALS[$i]}"
      return
    fi
  done
  echo "${2:-}"
}

# every value of a repeatable flag, one per line
flag_all() {
  local i
  for i in "${!FLAG_KEYS[@]}"; do
    [ "${FLAG_KEYS[$i]}" = "$1" ] && echo "${FLAG_VALS[$i]}"
  done
  return 0
}

pos() { echo "${POS[$1]:-}"; }

require_flag() {
  local v
  v=$(flag "$1")
  [ -z "$v" ] && die "Missing $1"
  echo "$v"
}

# ── HTTP ─────────────────────────────────────────────────────────────────────

LAST_RESPONSE=""

# Request with a 15s timeout and 2 retries with backoff. Prints the body.
api_request() {
  local method="$1"
  local path="$2"
  shift 2
  local data="${1:-}"

  require_api_key

  local url="${BASE_URL}${path}"
  local attempt=0
  local max_retries=2
  local response=""
  local http_code=""

  while [ $attempt -le $max_retries ]; do
    local curl_args=(
      --silent
      --show-error
      --max-time 15
      --write-out "\n%{http_code}"
      -H "Authorization: Bearer ${API_KEY}"
      -H "Content-Type: application/json"
      -H "User-Agent: kredit-cli/${VERSION}"
      -X "$method"
    )
    if [ -n "$data" ]; then
      curl_args+=(-d "$data")
    fi
    curl_args+=("$url")

    local raw
    raw=$(curl "${curl_args[@]}" 2>&1) || true

    http_code=$(echo "$raw" | tail -1)
    response=$(echo "$raw" | sed '$d')

    if [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      LAST_RESPONSE="$response"
      echo "$response" | format_json
      note_approval "$response"
      return 0
    fi

    if [[ "$http_code" =~ ^4[0-9][0-9]$ ]]; then
      echo "error: HTTP $http_code" >&2
      echo "$response" | format_json >&2
      return 1
    fi

    attempt=$((attempt + 1))
    if [ $attempt -le $max_retries ]; then
      sleep "$attempt"
    fi
  done

  echo "error: Request failed after $((max_retries + 1)) attempts (last HTTP ${http_code:-000})" >&2
  echo "$response" | format_json >&2
  return 1
}

# A change made with an API key that needs a person comes back as a pending
# approval instead of the changed record. Say so.
note_approval() {
  if echo "$1" | grep -q '"kind": *"\(org\.\|agent\.\)' && echo "$1" | grep -q '"status": *"pending"' \
     && echo "$1" | grep -q '"requested_by"'; then
    echo "" >&2
    echo "This change is waiting for a person. Approve it with a passkey at ${DASHBOARD_URL}/console/review." >&2
    echo "The active policy stays in force until then." >&2
  fi
}

# The organization for org-scoped commands
resolve_org() {
  local id
  id=$(flag --org)
  [ -n "$id" ] && { echo "$id"; return; }
  [ -n "${KREDIT_ORG:-}" ] && { echo "$KREDIT_ORG"; return; }
  id=$(config_get org)
  [ -n "$id" ] && { echo "$id"; return; }
  require_api_key
  id=$(curl --silent --max-time 15 -H "Authorization: Bearer ${API_KEY}" "${BASE_URL}/orgs" 2>/dev/null \
    | json_field '.[0].id')
  [ -z "$id" ] && die "No organization. Create one with 'kredit orgs create --name NAME' or pass --org ID"
  echo "$id"
}

# ── Login ────────────────────────────────────────────────────────────────────

cmd_login() {
  echo "Logging in to Kredit..."

  local port
  port=$(python3 -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()" 2>/dev/null) || die "Python 3 required for login"

  local token=""
  local login_url="${DASHBOARD_URL}/auth/cli-callback?port=${port}"

  python3 -c "
import http.server, urllib.parse, sys, threading

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        token = params.get('token', [''])[0]
        if token:
            self.send_response(200)
            self.send_header('Content-Type', 'text/html')
            self.end_headers()
            self.wfile.write(b'<html><body style=\"font-family:sans-serif;text-align:center;margin-top:80px\"><h2>Logged in to Kredit</h2><p>You can close this window and return to your terminal.</p></body></html>')
            with open('/tmp/.kredit_cli_token', 'w') as f:
                f.write(token)
            threading.Thread(target=self.server.shutdown).start()
        else:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b'Missing token')
    def log_message(self, *args): pass

server = http.server.HTTPServer(('127.0.0.1', ${port}), Handler)
server.serve_forever()
" &
  local server_pid=$!

  echo "Opening browser for authentication..."
  if command -v open &>/dev/null; then
    open "$login_url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$login_url"
  else
    echo "Open this URL in your browser:"
    echo "  $login_url"
  fi

  echo "Waiting for authentication..."

  local waited=0
  while kill -0 $server_pid 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
    if [ $waited -ge 120 ]; then
      kill $server_pid 2>/dev/null
      rm -f /tmp/.kredit_cli_token
      die "Login timed out after 120 seconds"
    fi
  done

  if [ ! -f /tmp/.kredit_cli_token ]; then
    die "Login failed: no token received"
  fi

  token=$(cat /tmp/.kredit_cli_token)
  rm -f /tmp/.kredit_cli_token

  if [ -z "$token" ]; then
    die "Login failed: empty token"
  fi

  echo "Authenticated. Creating API key..."

  local response
  response=$(curl --silent --show-error --max-time 10 \
    -X POST \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" \
    "${BASE_URL}/auth/keys" 2>&1) || die "Failed to create API key"

  local api_key
  api_key=$(echo "$response" | json_field '.key')

  if [ -z "$api_key" ]; then
    echo "error: Failed to create API key" >&2
    echo "$response" | format_json >&2
    exit 1
  fi

  config_set api_key "$api_key"
  API_KEY="$api_key"

  echo ""
  echo "API key created and saved to ~/.kredit/config"
  echo "Key: ${api_key}"
  echo ""
  echo "You're ready to go. Try: kredit orgs create --name my-team"
}

cmd_logout() {
  if [ -f "$CONFIG_FILE" ]; then
    rm "$CONFIG_FILE"
    echo "Logged out. API key removed from ~/.kredit/config"
  else
    echo "Not logged in."
  fi
}

cmd_whoami() {
  api_request GET "/session"
}

# ── Organizations ────────────────────────────────────────────────────────────

cmd_orgs() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  case "$sub" in
    list) api_request GET "/orgs" ;;
    get) api_request GET "/orgs/$(pos 0 | grep . || resolve_org)" ;;
    create)
      local name
      name=$(require_flag --name)
      api_request POST "/orgs" "$(json_obj "name:$(json_str "$name")" "description:$(opt_str --description)")"
      ;;
    update)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit orgs update ID [--name N] [--description D]"
      api_request PUT "/orgs/$id" "$(json_obj "name:$(opt_str --name)" "description:$(opt_str --description)")"
      ;;
    delete)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit orgs delete ID"
      api_request DELETE "/orgs/$id"
      ;;
    summary) api_request GET "/orgs/$(pos 0 | grep . || resolve_org)/summary" ;;
    use)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit orgs use ID"
      config_set org "$id"
      echo "Organization $id is now the default (org=$id in ~/.kredit/config)"
      ;;
    *) die "Unknown orgs command: $sub. Use list, get, create, update, delete, summary or use" ;;
  esac
}

# An optional string flag as JSON, or empty so json_obj skips it
opt_str() {
  local v
  v=$(flag "$1")
  [ -n "$v" ] && json_str "$v"
  return 0
}

opt_list() {
  local v
  v=$(flag "$1")
  [ -n "$v" ] && json_list "$v"
  return 0
}

opt_num() {
  local v
  v=$(flag "$1")
  [ -n "$v" ] && echo "$v"
  return 0
}

opt_bool() {
  local v
  v=$(flag "$1")
  case "$v" in
    true|false) echo "$v" ;;
    "") ;;
    *) die "$1 must be true or false" ;;
  esac
  return 0
}

opt_limit() {
  local v
  v=$(flag "$1")
  [ -n "$v" ] && parse_limit "$v" "$2"
  return 0
}

# ── Rules (per organization) ─────────────────────────────────────────────────

rule_body() {
  local on_hit
  on_hit=$(flag --on-hit)
  case "$on_hit" in
    ""|deny|review) ;;
    *) die "--on-hit must be deny or review" ;;
  esac
  json_obj \
    "name:$(opt_str --name)" \
    "type:$(opt_str --type)" \
    "providers:$(opt_list --providers)" \
    "spend:$(opt_limit --spend amount)" \
    "hit_rate:$(opt_limit --hit-rate count)" \
    "allowed:$(opt_list --allowed)" \
    "blocked:$(opt_list --blocked)" \
    "on_hit:$(opt_str --on-hit)" \
    "enabled:$(opt_bool --enabled)"
}

cmd_rules() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  local org
  org=$(resolve_org)
  case "$sub" in
    list) api_request GET "/orgs/$org/rules" ;;
    add) api_request POST "/orgs/$org/rules" "$(rule_body)" ;;
    update)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit rules update RULE_ID [flags]"
      api_request PUT "/orgs/$org/rules/$id" "$(rule_body)"
      ;;
    remove)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit rules remove RULE_ID"
      api_request DELETE "/orgs/$org/rules/$id"
      ;;
    *) die "Unknown rules command: $sub. Use list, add, update or remove" ;;
  esac
}

# ── Agents ───────────────────────────────────────────────────────────────────

guardrails_body() {
  json_obj \
    "max_per_action:$(opt_num --max-per-action)" \
    "require_review_above:$(opt_num --review-above)" \
    "allowed_merchants:$(opt_list --allowed)" \
    "blocked_merchants:$(opt_list --blocked)"
}

# What the agent may do, as the one tool that grants it: --scopes a,b, payments when left out.
# Without a tool that covers an action, the check denies it.
agent_tools_body() {
  local scopes
  scopes=$(opt_list --scopes)
  [ -z "$scopes" ] && scopes='["payment.*"]'
  printf '[{"name":"payments","scopes":%s}]' "$scopes"
}

# A per-agent spend rule from --spend AMOUNT/WINDOW, as a one-item rules list
agent_rules_body() {
  local spend
  spend=$(flag --spend)
  [ -z "$spend" ] && return 0
  echo "[$(json_obj "name:$(json_str "spend $spend")" "type:\"payment\"" "spend:$(parse_limit "$spend" amount)")]"
}

cmd_agents() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  local id
  id=$(pos 0)
  case "$sub" in
    list) api_request GET "/orgs/$(resolve_org)/agents" ;;
    get)
      [ -z "$id" ] && die "Usage: kredit agents get ID"
      api_request GET "/agents/$id"
      ;;
    create)
      local name prompt
      name=$(require_flag --name)
      prompt=$(require_flag --prompt)
      local guard
      guard=$(guardrails_body)
      [ "$guard" = "{}" ] && guard=""
      api_request POST "/orgs/$(resolve_org)/agents" "$(json_obj \
        "name:$(json_str "$name")" \
        "prompt:$(json_str "$prompt")" \
        "description:$(opt_str --description)" \
        "tools:$(agent_tools_body)" \
        "guardrails:$guard" \
        "rules:$(agent_rules_body)")"
      ;;
    update)
      [ -z "$id" ] && die "Usage: kredit agents update ID [--name N] [--description D]"
      api_request PUT "/agents/$id" "$(json_obj "name:$(opt_str --name)" "description:$(opt_str --description)")"
      ;;
    freeze)
      [ -z "$id" ] && die "Usage: kredit agents freeze ID"
      api_request PUT "/agents/$id" '{"status":"frozen"}'
      ;;
    unfreeze)
      [ -z "$id" ] && die "Usage: kredit agents unfreeze ID"
      api_request PUT "/agents/$id" '{"status":"active"}'
      ;;
    delete)
      [ -z "$id" ] && die "Usage: kredit agents delete ID"
      api_request DELETE "/agents/$id"
      ;;
    verify)
      [ -z "$id" ] && die "Usage: kredit agents verify ID [--provider kredit|skyfire|kite]"
      api_request POST "/agents/$id/verify-identity" "$(json_obj "provider:$(opt_str --provider)")"
      ;;
    promote)
      [ -z "$id" ] && die "Usage: kredit agents promote ID"
      api_request POST "/agents/$id/promote" '{"environment":"production"}'
      ;;
    decisions)
      [ -z "$id" ] && die "Usage: kredit agents decisions ID [--limit N]"
      api_request GET "/agents/$id/decisions?limit=$(flag --limit 50)"
      ;;
    *) die "Unknown agents command: $sub. Use list, get, create, update, freeze, unfreeze, delete, verify, promote or decisions" ;;
  esac
}

# ── Agent versions ───────────────────────────────────────────────────────────

cmd_versions() {
  local sub="${1:-}"
  shift || true
  parse_args "$@"
  local agent_id vid
  agent_id=$(pos 0)
  vid=$(pos 1)
  case "$sub" in
    propose)
      [ -z "$agent_id" ] && die "Usage: kredit versions propose AGENT_ID [--prompt P --allowed a,b --blocked a,b --max-per-action N --review-above N --spend AMOUNT/WINDOW --note T]"
      local guard
      guard=$(guardrails_body)
      [ "$guard" = "{}" ] && guard=""
      api_request POST "/agents/$agent_id/versions" "$(json_obj \
        "prompt:$(opt_str --prompt)" \
        "guardrails:$guard" \
        "rules:$(agent_rules_body)" \
        "note:$(opt_str --note)")"
      ;;
    approve)
      [ -z "$vid" ] && die "Usage: kredit versions approve AGENT_ID VERSION_ID [--env sandbox|production]"
      api_request POST "/agents/$agent_id/versions/$vid/approve" "$(json_obj "environment:$(json_str "$(flag --env sandbox)")")"
      ;;
    reject)
      [ -z "$vid" ] && die "Usage: kredit versions reject AGENT_ID VERSION_ID [--note T]"
      api_request POST "/agents/$agent_id/versions/$vid/reject" "$(json_obj "note:$(opt_str --note)")"
      ;;
    *) die "Unknown versions command: $sub. Use propose, approve or reject" ;;
  esac
}

# ── Agent tokens ─────────────────────────────────────────────────────────────

cmd_tokens() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  local agent_id
  agent_id=$(pos 0)
  [ -z "$agent_id" ] && die "Usage: kredit tokens $sub AGENT_ID"
  case "$sub" in
    issue)
      api_request POST "/agents/$agent_id/tokens" "$(json_obj "ttl_minutes:$(opt_num --ttl)")" >/dev/null
      local token
      token=$(echo "$LAST_RESPONSE" | json_field '.token')
      echo "$LAST_RESPONSE" | format_json
      echo "" >&2
      echo "The token is shown once. Give it to the agent as KREDIT_API_KEY:" >&2
      echo "  $token" >&2
      ;;
    list) api_request GET "/agents/$agent_id/tokens" ;;
    revoke)
      local tid
      tid=$(pos 1)
      [ -z "$tid" ] && die "Usage: kredit tokens revoke AGENT_ID TOKEN_ID"
      api_request DELETE "/agents/$agent_id/tokens/$tid"
      ;;
    *) die "Unknown tokens command: $sub. Use issue, list or revoke" ;;
  esac
}

# ── Check ────────────────────────────────────────────────────────────────────

render_decision() {
  if ! has_jq; then
    format_json
    return
  fi
  jq -r '
    "\(.outcome | ascii_upcase)  score \(.score)  \(.latency_ms) ms",
    "\(.reason)",
    "",
    (.layers[] | "  \(.status | ascii_upcase | .[0:4] | . + "    "[0:4-length])  \(.name): \(.detail)"),
    "",
    "decision \(.id)"
  '
}

cmd_check() {
  parse_args "$@"
  local agent_id intent
  agent_id=$(flag --agent)
  [ -z "$agent_id" ] && agent_id=$(flag --agent-id)
  intent=$(pos 0)
  [ -z "$agent_id" ] && die "Usage: kredit check --agent AGENT_ID \"what the agent wants to do\" [--amount N --merchant M --domain D --category C --rail R --env E --json]"
  [ -z "$intent" ] && intent=$(flag --intent)
  [ -z "$intent" ] && die "Say what the agent wants to do, in words: kredit check --agent ID \"pay nike.com 129.99 for running shoes\""

  local merchant=""
  if [ -n "$(flag --merchant)$(flag --domain)$(flag --category)" ]; then
    merchant=$(json_obj \
      "name:$(json_str "$(flag --merchant "$(flag --domain)")")" \
      "domain:$(opt_str --domain)" \
      "category:$(opt_str --category)")
  fi
  local rail
  rail=$(flag --rail)
  case "$rail" in
    ""|card|usdc|skyfire|kite|ach|wire|crypto) ;;
    *) die "--rail must be card, usdc, skyfire, kite, ach, wire or crypto" ;;
  esac
  local env
  env=$(flag --env sandbox)
  case "$env" in
    sandbox|production) ;;
    *) die "--env must be sandbox or production" ;;
  esac

  local body
  body=$(json_obj \
    "agent_id:$(json_str "$agent_id")" \
    "org_id:$(opt_str --org)" \
    "environment:$(json_str "$env")" \
    "intent:$(json_str "$intent")" \
    "action:$(opt_str --action)" \
    "amount:$(opt_num --amount)" \
    "currency:$(opt_str --currency)" \
    "merchant:$merchant" \
    "counterparty:$(opt_str --counterparty)" \
    "payment_rail:$(opt_str --rail)")

  if [ "$(flag --json)" = "true" ]; then
    api_request POST "/check" "$body"
  else
    api_request POST "/check" "$body" >/dev/null
    echo "$LAST_RESPONSE" | render_decision
  fi
}

