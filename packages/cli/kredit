# ── Main ─────────────────────────────────────────────────────────────────────

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    login) cmd_login "$@" ;;
    logout) cmd_logout "$@" ;;
    whoami) cmd_whoami "$@" ;;
    orgs|org) cmd_orgs "$@" ;;
    rules|rule) cmd_rules "$@" ;;
    agents|agent) cmd_agents "$@" ;;
    versions|version) cmd_versions "$@" ;;
    tokens|token) cmd_tokens "$@" ;;
    check) cmd_check "$@" ;;
    decisions|decision) cmd_decisions "$@" ;;
    approvals|approval) cmd_approvals "$@" ;;
    documents|document|docs) cmd_documents "$@" ;;
    integrations|integration) cmd_integrations "$@" ;;
    audit) cmd_audit "$@" ;;
    orders) cmd_orders "$@" ;;
    environments|environment|env) cmd_environments "$@" ;;
    sim|simulations) cmd_sim "$@" ;;
    commerce) cmd_commerce "$@" ;;
    seed) cmd_seed "$@" ;;
    help|--help|-h) usage ;;
    --version|-v) echo "kredit ${VERSION}" ;;
    *)
      echo "Unknown command: $command" >&2
      echo "" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
