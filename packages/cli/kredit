# Stream a running simulation's SSE feed as an aligned table; prints the
# summary when the run completes. $1 = simulation id.
stream_simulation() {
  local sim_id="$1"

  # Ctrl-C (or TERM) → stop the server-side run, then leave.
  trap 'echo ""; curl -s -X POST "${BASE_URL}/simulations/${sim_id}/stop" -H "Authorization: Bearer ${API_KEY}" >/dev/null 2>&1; echo "  stopped simulation '"${sim_id}"'"; exit 0' INT TERM

  printf "  %-18s %-26s %10s   %-8s  %s\n" "AGENT" "ACTION" "COST" "STATUS" "REASON"
  echo "  ───────────────────────────────────────────────────────────────────────────────────"

  curl -sN "${BASE_URL}/simulations/${sim_id}/stream" \
    -H "Authorization: Bearer ${API_KEY}" \
    -H "User-Agent: kredit-cli/${VERSION}" \
  | while IFS= read -r line; do
      case "$line" in
        data:*) ;;
        *) continue ;;
      esac
      local json="${line#data:}"
      json="${json# }"
      local type
      type=$(printf '%s' "$json" | jq -r '.type // empty' 2>/dev/null)
      case "$type" in
        action)
          local agent action cost status reason
          agent=$(printf '%s'  "$json" | jq -r '.action.agent_name // "-"' 2>/dev/null)
          action=$(printf '%s' "$json" | jq -r '.action.action // "-"' 2>/dev/null)
          cost=$(printf '%s'   "$json" | jq -r '.action.cost // 0' 2>/dev/null)
          status=$(printf '%s' "$json" | jq -r '.action.card.status // "-"' 2>/dev/null)
          reason=$(printf '%s' "$json" | jq -r '.action.card.block_reason // ""' 2>/dev/null)
          printf "  %-18s %-26s \$%9s   %-8s  %s\n" \
            "$agent" "$action" "$cost" "$status" "$reason"
          ;;
        done)
          echo "  ───────────────────────────────────────────────────────────────────────────────────"
          break
          ;;
      esac
    done
  trap - INT TERM

  # ── Summary block from the persisted run record ──────────────────────────
  local rec
  rec=$(curl -s "${BASE_URL}/simulations/${sim_id}" \
    -H "Authorization: Bearer ${API_KEY}" 2>/dev/null)
  local total spend prevented blocked flagged
  total=$(printf '%s' "$rec" | jq -r '.total_actions // 0' 2>/dev/null)
  spend=$(printf '%s' "$rec" | jq -r '.total_spend // 0' 2>/dev/null)
  prevented=$(printf '%s' "$rec" | jq -r '.prevented_spend // 0' 2>/dev/null)
  blocked=$(printf '%s' "$rec" | jq -r '.blocked_count // 0' 2>/dev/null)
  flagged=$(printf '%s' "$rec" | jq -r '.flagged_count // 0' 2>/dev/null)
  echo ""
  echo "  ═══════════════════════════════════════════════════════════════════"
  echo "  Simulation summary"
  echo "  ═══════════════════════════════════════════════════════════════════"
  printf "  %-22s %s\n" "Total actions"    "$total"
  printf "  %-22s \$%s\n" "Total spend"     "$spend"
  printf "  %-22s \$%s\n" "Prevented spend" "$prevented"
  printf "  %-22s %s\n" "Blocked"          "$blocked"
  printf "  %-22s %s\n" "Flagged"          "$flagged"
  echo "  ═══════════════════════════════════════════════════════════════════"
}

# kredit pilot — the full terminal flow: create an organization, seed a fleet
# with guardrail rules, stream a live pilot simulation into the terminal, and
# open the run's environment in the platform.
cmd_pilot() {
  require_api_key
  local agent_count=10 integrations="" org_name=""
  for arg in "$@"; do
    case "$arg" in
      --agents=*|--agent-count=*) agent_count="${arg#*=}" ;;
      --integrations=*) integrations="${arg#--integrations=}" ;;
      --org=*|--name=*) org_name="${arg#*=}" ;;
      --help) echo "Usage: kredit pilot [--agents=N] [--integrations=stripe,visa,...] [--org=NAME]"; return 0 ;;
      --*) die "Unknown argument: $arg" ;;
    esac
  done

  # Relax strict mode — a curl/jq hiccup must not kill the flow.
  set +e
  set +u
  set +o pipefail

  kredit_banner
  echo "  This pilot stands up an organization with a ${agent_count}-agent fleet and"
  echo "  streams a live simulation of real-world API spend, payouts, and infra costs."
  echo ""

  # ── [1/3] Organization ────────────────────────────────────────────────────
  [ -z "$org_name" ] && org_name="kredit-pilot-$(date +%Y%m%d-%H%M%S)"
  echo "[1/3] Creating organization: $org_name"
  local org_resp org_id
  org_resp=$(curl -s -X POST "${BASE_URL}/orgs" \
    -H "Authorization: Bearer ${API_KEY}" -H "Content-Type: application/json" \
    -H "User-Agent: kredit-cli/${VERSION}" \
    -d "{\"name\":\"${org_name}\"}" 2>/dev/null)
  org_id=$(printf '%s' "$org_resp" | jq -r '.id // empty' 2>/dev/null)
  [ -z "$org_id" ] && die "Failed to create organization: $org_resp"
  echo "      org_id: $org_id"
  echo ""

  # ── [2/3] Fleet: agents + guardrail rules, seeded into the sandbox-mode env ─
  echo "[2/3] Creating ${agent_count} agents + guardrail rules..."
  local body
  if [ -n "$integrations" ]; then
    local integs_json
    integs_json=$(printf '%s' "$integrations" | awk -F, '{printf "["; for(i=1;i<=NF;i++){printf "%s\"%s\"",(i>1?",":""),$i} printf "]"}')
    body="{\"agent_count\":${agent_count},\"integrations\":${integs_json}}"
  else
    body="{\"agent_count\":${agent_count}}"
  fi
  local pilot_resp sim_id env_id rules
  pilot_resp=$(curl -s -X POST "${BASE_URL}/orgs/${org_id}/pilot" \
    -H "Authorization: Bearer ${API_KEY}" -H "Content-Type: application/json" \
    -H "User-Agent: kredit-cli/${VERSION}" -d "$body" 2>/dev/null)
  sim_id=$(printf '%s' "$pilot_resp" | jq -r '.simulation_id // empty' 2>/dev/null)
  env_id=$(printf '%s' "$pilot_resp" | jq -r '.environment_id // empty' 2>/dev/null)
  rules=$(printf '%s' "$pilot_resp" | jq -r '.rules_added // 0' 2>/dev/null)
  [ -z "$sim_id" ] && die "Pilot failed: $pilot_resp"

  # per-agent ✓ rows (identity + score), like the classic flow
  curl -s "${BASE_URL}/agents?org_id=${org_id}" \
    -H "Authorization: Bearer ${API_KEY}" 2>/dev/null \
  | jq -r '.[] | "      ✓ \(.name)|priority=\(.priority)|score=\(.credit.score)|id=\(.id)"' 2>/dev/null \
  | awk -F'|' '{printf "%s %-12s %-18s %-11s %s\n", "", $1, $2, $3, $4}'
  echo ""
  echo "      Created $(printf '%s' "$pilot_resp" | jq -r '(.agent_ids | length) // 0') agents + ${rules} guardrail rules"
  echo ""

  # ── [3/3] Live simulation, streamed into the terminal ─────────────────────
  echo "[3/3] Running the pilot simulation (Ctrl-C to stop)..."
  echo ""
  local url="${DASHBOARD_URL}/platform/environments/${env_id}"
  echo "  Opening the run's environment: $url"
  open_url "$url"
  echo ""
  stream_simulation "$sim_id"
  echo ""
  echo "  Environment: $url"
  echo ""
}

cmd_sim() {
  local subcmd="${1:-}"; shift 2>/dev/null || true
  local org_id="" env_id="" mode="predictive" period="1mo" duration="60" budget="0" seed="42" args="" id=""
  local positionals=()
  for arg in "$@"; do
    case "$arg" in
      --org-id=*) org_id="${arg#--org-id=}" ;;
      --environment-id=*|--env-id=*) env_id="${arg#*=}" ;;
      --mode=*) mode="${arg#--mode=}" ;;
      --period=*) period="${arg#--period=}" ;;
      --duration=*) duration="${arg#--duration=}" ;;
      --monthly-budget=*) budget="${arg#--monthly-budget=}" ;;
      --seed=*) seed="${arg#--seed=}" ;;
      --args=*) args="${arg#--args=}" ;;
      --id=*) id="${arg#--id=}" ;;
      --help) ;;
      --*) die "Unknown argument: $arg" ;;
      *) positionals+=("$arg") ;;
    esac
  done
  # "live" is an alias for realtime everywhere
  [ "$mode" = "live" ] && mode="realtime"
  case "$subcmd" in
    live|"")
      # The full terminal flow: stream a live run on the activated org's fleet.
      # No org (or an empty one) → fall back to the complete pilot bootstrap.
      require_api_key
      set +e; set +u; set +o pipefail
      local oid; oid=$(resolve_org_id "$org_id")
      local agents_n=0
      if [ -n "$oid" ]; then
        agents_n=$(curl -s "${BASE_URL}/agents?org_id=${oid}" \
          -H "Authorization: Bearer ${API_KEY}" 2>/dev/null | jq -r 'length' 2>/dev/null)
      else
        agents_n=$(curl -s "${BASE_URL}/agents" \
          -H "Authorization: Bearer ${API_KEY}" 2>/dev/null | jq -r 'length' 2>/dev/null)
      fi
      if [ -z "$agents_n" ] || [ "$agents_n" = "0" ]; then
        cmd_pilot
        return
      fi

      kredit_banner
      echo "  Streaming a live simulation of your fleet (${agents_n} agents) —"
      echo "  real transactions through the kredit cycle: intent → identity →"
      echo "  trust → execute → observe → optimize."
      echo ""
      local body="{\"mode\":\"realtime\",\"duration_sec\":${duration},\"seed\":${seed},\"stream\":true}"
      [ -n "$oid" ] && body="{\"org_id\":\"${oid}\",${body#\{}"
      [ -n "$env_id" ] && body="${body%\}},\"environment_id\":\"${env_id}\"}"
      local resp sim_id sim_env
      resp=$(curl -s -X POST "${BASE_URL}/simulations/run" \
        -H "Authorization: Bearer ${API_KEY}" -H "Content-Type: application/json" \
        -H "User-Agent: kredit-cli/${VERSION}" -d "$body" 2>/dev/null)
      sim_id=$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null)
      [ -z "$sim_id" ] && die "Failed to start simulation: $resp"
      sim_env=$(printf '%s' "$resp" | jq -r '.environment_id // empty' 2>/dev/null)
      local url="${DASHBOARD_URL}/platform/environments/${sim_env}"
      echo "  Opening the run's environment: $url"
      open_url "$url"
      echo ""
      stream_simulation "$sim_id"
      echo ""
      echo "  Environment: $url"
      echo ""
      ;;
    stop)
      local sid="${positionals[0]:-$id}"
      [ -z "$sid" ] && die "Usage: kredit simulation stop <simulation_id>"
      api_request POST "/simulations/${sid}/stop" ;;
    predictive)
      local oid; oid=$(resolve_org_id "$org_id")
      local pbody="{\"mode\":\"predictive\",\"period\":\"${period}\",\"seed\":${seed}"
      [ -n "$oid" ] && pbody="${pbody},\"org_id\":\"${oid}\""
      [ -n "$env_id" ] && pbody="${pbody},\"environment_id\":\"${env_id}\""
      pbody="${pbody}}"
      api_request POST "/simulations/run" "$(merge_args "$pbody" "$args")" ;;
    run)
      local oid; oid=$(resolve_org_id "$org_id")
      local body="{\"mode\":\"${mode}\",\"period\":\"${period}\",\"duration_sec\":${duration},\"monthly_budget\":${budget},\"seed\":${seed}"
      [ -n "$oid" ] && body="${body},\"org_id\":\"${oid}\""
      [ -n "$env_id" ] && body="${body},\"environment_id\":\"${env_id}\""
      body="${body}}"
      api_request POST "/simulations/run" "$(merge_args "$body" "$args")" ;;
    list)
      local oid; oid=$(resolve_org_id "$org_id")
      if [ -n "$oid" ]; then api_request GET "/simulations?org_id=${oid}"; else api_request GET "/simulations"; fi ;;
    get)
      local sid="${positionals[0]:-$id}"
      [ -z "$sid" ] && die "Missing --id (simulation id)"; api_request GET "/simulations/${sid}" ;;
    --help|help)
      cat <<'H'
Usage: kredit simulation [subcommand]
  (none) | live [--org-id=ID] [--environment-id=ENV_ID] [--duration=SECS]
        stream a live simulation of the activated org's fleet in the terminal
        and open the run's environment in the platform. An empty org falls
        back to the full pilot bootstrap (org + agents + rules + run).
  predictive [--org-id=ID] [--environment-id=ENV_ID] [--period=1d|1wk|2wk|1mo|1quarter|1year] [--seed=N]
        project the fleet over a horizon with weekly guardrail optimization
  run  [--org-id=ID] [--mode=predictive|live] [--period=1mo] [--duration=60] [--seed=N]
  list [--org-id=ID] | get <SIM_ID> | stop <SIM_ID>
H
      ;;
    *) die "Unknown simulation subcommand: $subcmd" ;;
  esac
}

