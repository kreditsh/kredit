# ── Agentic commerce ─────────────────────────────────────────────────────────

cmd_commerce() {
  local sub="${1:-workflows}"
  shift || true
  parse_args "$@"
  local id
  id=$(pos 0)
  case "$sub" in
    workflows) api_request GET "/orgs/$(resolve_org)/commerce/workflows" ;;
    update)
      [ -z "$id" ] && die "Usage: kredit commerce update WORKFLOW_ID [--name N --query Q --agent AGENT_ID]"
      api_request PUT "/commerce/workflows/$id" "$(json_obj \
        "name:$(opt_str --name)" \
        "query:$(opt_str --query)" \
        "agent_id:$(opt_str --agent)")"
      ;;
    runs) api_request GET "/orgs/$(resolve_org)/commerce/runs?limit=$(flag --limit 20)" ;;
    run)
      [ -z "$id" ] && die "Usage: kredit commerce run RUN_ID"
      api_request GET "/commerce/runs/$id"
      ;;
    start)
      [ -z "$id" ] && die "Usage: kredit commerce start WORKFLOW_ID [--query Q --budget N --choice you|agent --from-run RUN_ID]"
      local choice
      choice=$(flag --choice you)
      case "$choice" in
        you|agent) ;;
        *) die "--choice must be you or agent" ;;
      esac
      api_request POST "/orgs/$(resolve_org)/commerce/runs" "$(json_obj \
        "workflow_id:$(json_str "$id")" \
        "query:$(opt_str --query)" \
        "budget:$(opt_num --budget)" \
        "choice_mode:$(json_str "$choice")" \
        "from_run_id:$(opt_str --from-run)")"
      ;;
    choose)
      [ -z "$id" ] && die "Usage: kredit commerce choose RUN_ID [FIND_ID]   (no find id: the agent takes the top option)"
      local find_id
      find_id=$(pos 1)
      api_request POST "/commerce/runs/$id/choose" "$(json_obj "find_id:$( [ -n "$find_id" ] && json_str "$find_id")")"
      ;;
    rechoose)
      local find_id
      find_id=$(pos 1)
      [ -z "$find_id" ] && die "Usage: kredit commerce rechoose RUN_ID FIND_ID"
      api_request POST "/commerce/runs/$id/rechoose" "$(json_obj "find_id:$(json_str "$find_id")")"
      ;;
    stop)
      [ -z "$id" ] && die "Usage: kredit commerce stop RUN_ID"
      api_request POST "/commerce/runs/$id/stop"
      ;;
    *) die "Unknown commerce command: $sub. Use workflows, update, runs, run, start, choose, rechoose or stop" ;;
  esac
}

