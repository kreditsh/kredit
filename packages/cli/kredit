# ── Documents ────────────────────────────────────────────────────────────────

cmd_documents() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  local org
  org=$(resolve_org)
  case "$sub" in
    list) api_request GET "/orgs/$org/documents" ;;
    add)
      local name file text url content kind
      name=$(require_flag --name)
      file=$(flag --file)
      text=$(flag --text)
      url=$(flag --url)
      if [ -n "$file" ]; then
        [ -f "$file" ] || die "No such file: $file"
        content=$(cat "$file")
        kind="file"
      elif [ -n "$url" ]; then
        content=""
        kind="url"
      elif [ -n "$text" ]; then
        content="$text"
        kind="text"
      else
        die "Give the document as --file PATH, --text \"...\" or --url URL"
      fi
      api_request POST "/orgs/$org/documents" "$(json_obj \
        "name:$(json_str "$name")" \
        "kind:$(json_str "$kind")" \
        "url:$(opt_str --url)" \
        "content:$( [ -n "$content" ] && json_str "$content")" \
        "tags:$(opt_list --tags)")"
      ;;
    search)
      local q
      q=$(flag --q)
      [ -z "$q" ] && q=$(pos 0)
      [ -z "$q" ] && die "Usage: kredit documents search --q \"words\""
      api_request GET "/orgs/$org/documents/search?q=$(printf '%s' "$q" | jq -sRr @uri 2>/dev/null || printf '%s' "$q" | sed 's/ /%20/g')"
      ;;
    delete)
      local id
      id=$(pos 0)
      [ -z "$id" ] && die "Usage: kredit documents delete ID"
      api_request DELETE "/documents/$id"
      ;;
    *) die "Unknown documents command: $sub. Use list, add, search or delete" ;;
  esac
}

# ── Integrations ─────────────────────────────────────────────────────────────

cmd_integrations() {
  local sub="${1:-list}"
  shift || true
  parse_args "$@"
  local org provider
  org=$(resolve_org)
  provider=$(pos 0)
  case "$sub" in
    list) api_request GET "/orgs/$org/integrations" ;;
    set)
      [ -z "$provider" ] && die "Usage: kredit integrations set PROVIDER [--key name=value ...] [--enabled true|false] [--mode simulated|sandbox|live]"
      local keys="" kv
      while IFS= read -r kv; do
        [ -z "$kv" ] && continue
        [[ "$kv" != *=* ]] && die "--key takes name=value, got '$kv'"
        keys="${keys:+$keys,}$(json_str "${kv%%=*}"):$(json_str "${kv#*=}")"
      done < <(flag_all --key)
      local mode
      mode=$(flag --mode)
      case "$mode" in
        ""|simulated|sandbox|live) ;;
        *) die "--mode must be simulated, sandbox or live" ;;
      esac
      api_request PUT "/orgs/$org/integrations/$provider" "$(json_obj \
        "keys:$( [ -n "$keys" ] && echo "{$keys}")" \
        "enabled:$(opt_bool --enabled)" \
        "mode:$(opt_str --mode)")"
      ;;
    test)
      [ -z "$provider" ] && die "Usage: kredit integrations test PROVIDER"
      api_request POST "/orgs/$org/integrations/$provider/test"
      ;;
    *) die "Unknown integrations command: $sub. Use list, set or test" ;;
  esac
}

