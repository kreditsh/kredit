Model:
  Organizations are the top level — they own agents, environments, workflows
  and rules. Every environment has a mode: sandbox | preview | production
  (one production env per org). Every simulation run is its own sandbox-mode
  environment. `kredit org activate <id>` points the API + CLI at one org;
  after that, org-scoped commands need no --org-id.

Options:
  --help      Show help for a command
  --version   Print version

Examples:
  kredit pilot --agents=10 --integrations=stripe,openai
  kredit simulation
  kredit org list
  kredit org create acme && kredit org activate <org_id>
  kredit agents list --mode=sandbox
  kredit agents create --name=bot-01 --mode=preview
  kredit check --agent-id=agt_8f3k2m --action=serp_api.search --estimated-cost=1 --environment-id=env_123
  kredit run openai.chat --agent agt_8f3k2m --environment-id env_123 --cost 1 --type api_call
  kredit report --transaction-id=txn_abc --outcome=success --actual-cost=1
  kredit rules add --agent-id=ID --name="OpenAI" --match="openai.*" --max-cost-per-txn=5 --daily-spend-limit=100
  kredit kya checkout-bot
  kredit kyb acme --provider=experian
  kredit priors presets
  kredit priors set --name=web-search --frequency-mean=6 --cost-mean=3 --seasonality-preset=weekday
  kredit workflow create --name=demo --graph='{"nodes":[{"id":"n1","type":"llm"}],"edges":[]}'
  kredit workflow execute wf_123 --environment-id=env_123
  kredit environment list
  kredit environment create --mode=sandbox --name=exp-a
  kredit chat list

Environment:
  KREDIT_API_KEY   API key (or set in ~/.kredit/config as api_key=...)
  KREDIT_API_URL   Base URL (default: https://api.kredit.sh)
  KREDIT_ORG_ID    Organization id (or org_id=... in ~/.kredit/config)
HELP
}

# ── Main dispatch ────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    login)    cmd_login "$@" ;;
    logout)   cmd_logout "$@" ;;
    init)     cmd_init "$@" ;;
    pilot)    cmd_pilot "$@" ;;
    simulation) cmd_sim "$@" ;;
    check)    cmd_check "$@" ;;
    run)      cmd_run "$@" ;;
    report)   cmd_report "$@" ;;
    agents)   cmd_agents "$@" ;;
    rules)    cmd_rules "$@" ;;
    org|orgs) cmd_orgs "$@" ;;
    action)   cmd_action "$@" ;;
    execute)  cmd_execute "$@" ;;
    verify)   cmd_verify "$@" ;;
    kya)      cmd_kya "$@" ;;
    kyb)      cmd_kyb "$@" ;;
    kyc)      cmd_kyc "$@" ;;
    optimize) cmd_optimize "$@" ;;
    priors)   cmd_priors "$@" ;;
    workflow) cmd_workflow "$@" ;;
    environment|env) cmd_environment "$@" ;;
    chat)     cmd_chat "$@" ;;
    score)    cmd_score "$@" ;;
    wallet)   cmd_wallet "$@" ;;
    --help|-h|help) show_help ;;
    --version|-v) echo "kredit $VERSION" ;;
    "")
      show_help
      exit 1
      ;;
    *)
      die "Unknown command: $cmd. Run 'kredit --help' for usage."
      ;;
  esac
}

main "$@"
